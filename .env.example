# Copy to .env.local for local development. In production, set these as
# environment variables/secrets on your Cloudflare Workers deployment.
# See README "Sign in with Google or Microsoft" for full setup instructions.

# Required — signs/encrypts session cookies. Generate with `npx auth secret`.
AUTH_SECRET=

# Google OAuth — Google Cloud Console > APIs & Services > Credentials.
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID OAuth — Microsoft Entra admin center > App registrations.
# Redirect URI: https://<your-domain>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional — omit to allow any Microsoft account (personal, school, or work).
# Set to restrict sign-in to one organization's tenant:
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Optional — free-tier paywall CTAs (see "Free Tier & Monetization" in README).
NEXT_PUBLIC_UPGRADE_URL=
NEXT_PUBLIC_CONTACT_URL=

# Optional — protects POST /api/admin/set-plan and
# POST /api/admin/refresh-knowledge-base (x-admin-token header).
ADMIN_TOKEN=

# Optional — enables LLM-powered compliance analysis (see "Smart Analysis"
# in README). Without this, the checker falls back to the built-in static
# heuristic — nothing breaks, you just don't get the AI-powered analysis.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-4-7. Lower to a cheaper model (e.g.
# claude-sonnet-4-6) to control per-check cost.
ANTHROPIC_MODEL=
# Optional — how often (in hours) the self-hosted background job refreshes
# the cached regulatory knowledge base. Default 24.
KNOWLEDGE_BASE_REFRESH_INTERVAL_HOURS=
# Optional — a cached source older than this (in days) is refreshed
# on-demand before the next smart check, regardless of the background job.
# Default 7.
KNOWLEDGE_BASE_MAX_STALENESS_DAYS=
