# Copy to .env.local for local development. In production, set these as
# environment variables/secrets on your Cloudflare Workers deployment.
# See README "Sign in with Google or Microsoft" for full setup instructions.

# Required — signs/encrypts session cookies. Generate with `npx auth secret`.
AUTH_SECRET=

# Google OAuth — Google Cloud Console > APIs & Services > Credentials.
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID OAuth — Microsoft Entra admin center > App registrations.
# Redirect URI: https://<your-domain>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional — omit to allow any Microsoft account (personal, school, or work).
# Set to restrict sign-in to one organization's tenant:
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Optional — free-tier paywall CTAs (see "Free Tier & Monetization" in README).
NEXT_PUBLIC_UPGRADE_URL=
NEXT_PUBLIC_CONTACT_URL=

# Optional — protects POST /api/admin/set-plan and
# POST /api/admin/refresh-knowledge-base (x-admin-token header).
ADMIN_TOKEN=

# Optional — enables LLM-powered compliance analysis (see "Smart Analysis"
# in README). Without this, the checker falls back to the built-in static
# heuristic — nothing breaks, you just don't get the AI-powered analysis.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini. Change to a different OpenAI model if
# you want to trade off cost/quality (must support Structured Outputs).
OPENAI_MODEL=
# Optional — how often (in hours) the self-hosted background job refreshes
# the cached regulatory knowledge base. Default 24.
KNOWLEDGE_BASE_REFRESH_INTERVAL_HOURS=
# Optional — a cached source older than this (in days) is refreshed
# on-demand before the next smart check, regardless of the background job.
# Default 7.
KNOWLEDGE_BASE_MAX_STALENESS_DAYS=

# Optional — enables real Stripe subscription billing for Pro/Team/Agency
# (see "Billing" in README). Without these, upgrade buttons fall back to the
# NEXT_PUBLIC_UPGRADE_URL mailto link — nothing breaks.
# Dashboard: https://dashboard.stripe.com/apikeys (use a test-mode key first)
STRIPE_SECRET_KEY=
# Dashboard: https://dashboard.stripe.com/webhooks — add an endpoint at
# <your-domain>/api/stripe/webhook subscribed to checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Price ids (not Product ids) for each paid tier x billing interval. Create
# one recurring Price per cell: Pro $29/mo or $24/mo billed yearly, Team
# $129/mo or $99/mo yearly, Agency from $299/mo (custom deals can be granted
# manually via POST /api/admin/set-plan instead of a fixed Price).
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_TEAM_MONTHLY=
STRIPE_PRICE_ID_TEAM_YEARLY=
STRIPE_PRICE_ID_AGENCY_MONTHLY=
STRIPE_PRICE_ID_AGENCY_YEARLY=

# Optional — enables Razorpay subscription billing for Pro/Team/Agency (see
# "Billing" in README). Needed for India-based merchants, since Stripe is
# currently invite-only in India. POST /api/billing/checkout prefers
# Razorpay over Stripe when both are configured.
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan ids (start with `plan_`) for each paid tier x billing interval,
# created under Subscriptions > Plans. India pricing: Pro ₹999/mo, Team
# ₹4,999/mo, Agency custom (grant manually via /api/admin/set-plan).
RAZORPAY_PLAN_ID_PRO_MONTHLY=
RAZORPAY_PLAN_ID_PRO_YEARLY=
RAZORPAY_PLAN_ID_TEAM_MONTHLY=
RAZORPAY_PLAN_ID_TEAM_YEARLY=
RAZORPAY_PLAN_ID_AGENCY_MONTHLY=
RAZORPAY_PLAN_ID_AGENCY_YEARLY=
# Dashboard: Account & Settings > Webhooks — add an endpoint at
# <your-domain>/api/razorpay/webhook subscribed to subscription.activated,
# subscription.charged, subscription.cancelled, subscription.completed,
# subscription.halted. Copy the webhook secret.
RAZORPAY_WEBHOOK_SECRET=
